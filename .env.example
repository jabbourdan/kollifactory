# Copy to .env (gitignored) and fill in. Values here win over ~/.jira-token.
# Empty values are ignored.

# Jira: where tickets come from. Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: overrides jira.base_url in factory/config.json
JIRA_BASE_URL=

# GitHub: only for branches and PRs. Optional when `gh auth status` is already
# logged in. A fine-grained token needs Contents and Pull requests: read/write.
GH_TOKEN=
